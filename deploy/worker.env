BIND_HOST=__WORKER_HOST__
PORT=__WORKER_PORT__
ALLOWED_PEERS=__APP_HOST__
SECRET_FILE=/etc/ai-checker/worker.secret
MODEL_DIR=__WORKER_DATA_ROOT__/models
CALIBRATION_FILE=/opt/ai-checker/aichecker/data/calibration.json
GPU_LOCK_FILE=__GPU_LOCK_FILE__
CONTROLLER_URL=__CONTROLLER_URL__
ENGINE_URL=http://127.0.0.1:11438
IDLE_UNLOAD_SECONDS=45
QUIET_SECONDS=20
GATE_WAIT_SECONDS=90
REWRITE_MODEL=qwen3:14b
EMBED_MODEL=nomic-embed-text
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONDONTWRITEBYTECODE=1
