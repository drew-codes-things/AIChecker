AUTH_MODE=proxy
BIND_HOST=127.0.0.1
PORT=__APP_PORT__
DATA_DIR=/var/lib/ai-checker
TRUSTED_PROXIES=127.0.0.1,::1
USER_HEADER=X-Forwarded-User
ALLOWED_USERS=__SIGNED_IN_USER__
WORKER_URL=http://__WORKER_HOST__:__WORKER_PORT__
WORKER_SECRET_FILE=/etc/ai-checker/worker.secret
CALIBRATION_FILE=/opt/ai-checker/aichecker/data/calibration.json
VOICE_FOLDER=
PYTHONDONTWRITEBYTECODE=1
